# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit real secrets.

# Public site URL — canonical links, sitemap.xml aur OG tags ke liye
VITE_SITE_URL=https://al-ucaaz.com

# --- Backend (NestJS + PostgreSQL) ---
# Jab backend ready ho jaye to ye set karo:
# Vercel dashboard me bhi same variables add karna (Project → Settings → Environment Variables)
VITE_API_URL=http://localhost:3000/api
VITE_USE_API=false
