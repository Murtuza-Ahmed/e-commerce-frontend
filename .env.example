# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit real secrets.

# Public site URL — canonical links, sitemap.xml aur OG tags ke liye
VITE_SITE_URL=https://al-ucaaz.com

# --- Backend (NestJS + PostgreSQL) ---
# Auth, users, admin — sab backend se chalta hai, ye LAZMI hai.
# Local backend:  http://localhost:3000/api
# Production:     https://<tumhara-render-app>.onrender.com/api
# Vercel dashboard me bhi same variable add karna (Project → Settings → Environment Variables)
VITE_API_URL=http://localhost:3000/api
